{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${PLUGIN_ROOT}/scripts/yello\" hooks session-start --via codex",
						"timeout": 60,
						"statusMessage": "Yello session startup"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${PLUGIN_ROOT}/scripts/yello\" hooks deliver --via codex",
						"timeout": 15,
						"statusMessage": "Yello delivery"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${PLUGIN_ROOT}/scripts/yello\" hooks deliver --via codex",
						"timeout": 15,
						"statusMessage": "Yello delivery"
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${PLUGIN_ROOT}/scripts/yello\" hooks session-end --via codex",
						"timeout": 3
					}
				]
			}
		]
	}
}
