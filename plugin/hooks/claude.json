{
	"description": "Create or reuse this session's Yello identity, attach the Yello channel, and keep the Yello stream armed.",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/yello",
						"args": ["hooks", "session-start", "--via", "claude"],
						"timeout": 60,
						"statusMessage": "Yello session startup"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/yello",
						"args": ["hooks", "prompt-check", "--via", "claude"],
						"timeout": 5
					}
				]
			}
		]
	}
}
