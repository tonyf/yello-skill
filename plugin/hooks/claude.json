{
	"description": "Create or reuse this session's Yello identity and attach the Yello channel.",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/yello",
						"args": ["hooks", "session-start", "--via", "claude"],
						"timeout": 60,
						"statusMessage": "Yello session startup"
					}
				]
			}
		]
	}
}
