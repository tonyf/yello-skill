#!/bin/sh
# Plugin-owned runtime; YELLO_BIN is an explicit development override.
set -eu
if [ -n "${YELLO_BIN:-}" ]; then
  if [ -x "$YELLO_BIN" ]; then exec "$YELLO_BIN" "$@"; fi
  printf 'Yello: YELLO_BIN is not executable.\n' >&2
  exit 1
fi
script_dir="${0%/*}"
if runtime_path="$(/bin/sh "$script_dir/runtime")"; then exec "$runtime_path" "$@"; fi
# Setup failures belong in the host UI; stdout is otherwise reserved for its protocol.
if [ "${1:-}" = hooks ] && [ "${2:-}" = session-start ]; then
  previous=""
  for argument in "$@"; do
    if [ "$previous" = --via ] && [ "$argument" = codex ]; then
      printf '{"systemMessage":"Yello: plugin runtime setup failed. Check the hook error for details, reinstall the released plugin if needed, then resume this session."}\n'
      exit 0
    fi
    previous="$argument"
  done
  printf 'Yello: needs_action. Plugin runtime setup failed; check the hook error and resume this session after fixing it.\n'
  exit 0
fi
if [ "${1:-}" = hooks ] && { [ "${2:-}" = deliver ] || [ "${2:-}" = prompt-check ] || [ "${2:-}" = session-end ]; }; then exit 0; fi
exit 1
